     xbmcplugin.addSortMethod(pluginhandle, xbmcplugin.SORT_METHOD_LABEL)
 
 
+def next_up_row(series_id, dir_items):
+    try:
+        data = api.get("/Shows/NextUp?SeriesId={}&UserId={}&Limit=1&Fields=Overview"
+                       "&EnableUserData=true&format=json".format(series_id, api.user_id))
+        episode = (data.get("Items") or [None])[0]
+    except Exception as e:
+        log.error("next up for {0}: {1}".format(series_id, e))
+        episode = None
+    if not episode:
+        return
+    resume = ((episode.get("UserData") or {}).get("PlaybackPositionTicks") or 0) > 0
+    label = "{} S{:02d}E{:02d} - {}".format("Continue" if resume else "Next",
+                                           episode.get("ParentIndexNumber") or 0,
+                                           episode.get("IndexNumber") or 0, episode.get("Name") or "")
+    list_item = xbmcgui.ListItem(label, offscreen=True)
+    list_item.setProperty("SpecialSort", "top")
+    thumb = "{}/Items/{}/Images/Primary?maxWidth=600".format(api.server, episode["Id"])
+    list_item.setArt({"thumb": thumb, "icon": "DefaultTVShows.png", "poster": thumb})
+    video_tag = list_item.getVideoInfoTag()
+    video_tag.setPlot(episode.get("Overview") or "")
+    video_tag.setMediaType("episode")
+    u = sys.argv[0] + "?mode=PLAY&item_id=" + episode["Id"]
+    dir_items.insert(0, (u, list_item, False))
+
